# Copy this file to `.env` and fill in your real keys:
#     cp .env.example .env
#
# `.env` is gitignored — it is NEVER committed. Only this template is.
# Keep your real keys out of source code entirely.

# Claude API — used by tactics.llm.ClaudeClient (LLM tactics + critic).
# Get one at https://console.anthropic.com/  (treat it like a password)
ANTHROPIC_API_KEY=

# Google Places API (New) — used by the Ruby lead_finder.rb pipeline.
# In Google Cloud Console, restrict the key to the Places API (+ your IP).
GOOGLE_PLACES_API_KEY=
