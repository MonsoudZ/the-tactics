# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tactics learning state (persisted memory)
# Ignore the contents (not the dir itself) so the negation below can apply —
# git won't re-include a file whose parent directory is excluded outright.
.tactics/*
*.tactics.json
# ...but curated verbal memory is knowledge, not state — keep it committed.
!.tactics/lessons.jsonl

# Secrets — never commit these (use env vars / a gitignored .env)
.env
.env.*
!.env.example
*.env
secrets.*
*_secret*
*.pem
*.key
credentials.json
service-account*.json

# Lead/outreach data (may contain business PII)
leads.csv
*.leads.csv

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
